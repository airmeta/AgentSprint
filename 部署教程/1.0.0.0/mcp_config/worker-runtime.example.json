{
  "Worker": {
    "WorkerId": "worker-1",
    "WorkerName": "agentsprint-codex-worker-1",
    "WorkspaceRoot": "/workspaces",
    "RunsRoot": "/runs",
    "CodexHome": "/codex-home",
    "PollIntervalSeconds": 15,
    "IdleMaxIntervalSeconds": 180,
    "MaxRunMinutes": 60,
    "CodexIdleTimeoutSeconds": 90,
    "CodexExecutable": "codex",
    "SandboxMode": "workspace-write",
    "RunSmokeOnStartup": false
  },
  "AgentSprint": {
    "ApiBaseUrl": "http://api:5000",
    "AgentToken": "${AGENTSPRINT_AGENT_TOKEN}"
  },
  "AkkaSettings": {
    "Enabled": true,
    "SystemName": "agentsprint-cluster",
    "Host": "math-codex-worker-1",
    "Port": 0,
    "SeedNodes": [
      "akka.tcp://agentsprint-cluster@api:25520"
    ],
    "Roles": [
      "agentsprint-worker"
    ]
  }
}
