{
  "ConnectionStrings": {
    "AgentSprintConnectionString": "server=192.168.100.100;port=3306;database=agentsprint;user=root;password=${AGENTSPRINT_DB_PASSWORD};Allow User Variables=True;UseAffectedRows=False;CharSet=utf8mb4;"
  },
  "Database": {
    "AutoInitialize": true
  },
  "RedisSettings": {
    "ConnectionString": "192.168.100.100:6379",
    "UserName": "",
    "Password": ""
  },
  "AkkaSettings": {
    "Enabled": true,
    "SystemName": "agentsprint-cluster",
    "Host": "api",
    "Port": 25520,
    "SeedNodes": [
      "akka.tcp://agentsprint-cluster@api:25520"
    ],
    "Roles": [
      "agentsprint-platform"
    ],
    "AskTimeoutSeconds": 10,
    "ShutdownTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "AgentSprint",
    "Audience": "AgentSprint.Admin",
    "SigningKey": "change-this-signing-key",
    "AccessTokenMinutes": 120
  },
  "AllowedHosts": "*"
}
