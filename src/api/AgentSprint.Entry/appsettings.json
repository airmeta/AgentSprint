{
  "ConnectionStrings": {
    "AgentSprintConnectionString": ""
  },
  "RedisSettings": {
    "ConnectionString": "redis:6379",
    "UserName": "",
    "Password": ""
  },
  "AkkaSettings": {
    "Enabled": true,
    "SystemName": "agentsprint-cluster",
    "Host": "api",
    "Port": 25520,
    "SeedNodes": [ "akka.tcp://agentsprint-cluster@api:25520" ],
    "Roles": [ "agentsprint-platform" ],
    "AskTimeoutSeconds": 10,
    "ShutdownTimeoutSeconds": 30,
    "Domains": {
      "AgentSprintPlatform": {
        "Role": "agentsprint-platform",
        "ActorNamePrefix": "agentsprint-platform",
        "AllowCrossDomainMessages": true
      }
    }
  },
  "Jwt": {
    "Issuer": "AgentSprint",
    "Audience": "AgentSprint.Admin",
    "SigningKey": "AgentSprint-development-signing-key-change-me",
    "AccessTokenMinutes": 120
  },
  "ProjectMaterials": {
    "StorageRoot": "api_run_directory",
    "RelativeRootPath": "project-materials",
    "MaxFileSizeMb": 50,
    "AllowedExtensions": [
      ".md",
      ".txt",
      ".pdf",
      ".docx",
      ".xlsx",
      ".pptx",
      ".png",
      ".jpg",
      ".jpeg",
      ".zip"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
